import DIB_PIXEL DIBENG.9
import DIB_REALIZEOBJECT DIBENG.10
import DIB_STRBLT DIBENG.11
import DIB_SCANLR DIBENG.12
import DIB_DEVICEMODE DIBENG.13
import DIB_EXTTEXTOUT DIBENG.14
import DIB_GETCHARWIDTH DIBENG.15
import DIB_DEVICEBITMAP DIBENG.16
import DIB_FASTBORDER DIBENG.17
import DIB_SETATTRIBUTE DIBENG.18
import DIB_DIBBLT DIBENG.19
import DIB_CREATEDIBITMAP DIBENG.20
import DIB_DIBTODEVICE DIBENG.21
import DIB_SETPALETTE DIBENG.22
import DIB_GETPALETTE DIBENG.23
import DIB_SETPALETTETRANSLATE DIBENG.24
import DIB_GETPALETTETRANSLATE DIBENG.25
