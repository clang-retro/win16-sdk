import DIB_SETCURSOREXT DIBENG.102
import DIB_MOVECURSOREXT DIBENG.103
import DIB_CHECKCURSOREXT DIBENG.104
import DIB_BEGINACCESS DIBENG.105
import DIB_ENDACCESS DIBENG.106
import CREATEDIBPDEVICE DIBENG.300
import DIB_REALIZEOBJECTEXT DIBENG.400
import DIB_DIBBLTEXT DIBENG.401
import DIB_ENUMOBJEXT DIBENG.402
import DIB_EXTTEXTOUTEXT DIBENG.403
import DIB_UPDATECOLORSEXT DIBENG.404
